{
  "name": "@revenuedot/mcp",
  "version": "0.2.0",
  "description": "MCP server for RevenueDot, the open-source subscription backend that works with the RevenueCat SDK. Manage products, entitlements, offerings, customers and webhooks from Claude, ChatGPT, Cursor and other AI assistants.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://revenuedot.app/docs/mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/revenuedot/mcp.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "revenuedot",
    "revenuecat",
    "in-app purchases",
    "subscriptions"
  ],
  "bin": {
    "revenuedot-mcp": "dist/cli.js",
    "mcp": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools.d.ts",
      "default": "./dist/tools.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts --http",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "cf deploy",
    "prepublishOnly": "npm run build",
    "dev:worker": "cf dev"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "hono": "^4.13.12",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vitest": "^2.1.8",
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-ad79608dd",
    "cf": "1.0.0-beta.5",
    "vite": "^8.3.1"
  }
}
